/* X-Link Billing — resilient compact 15-minute active-customer graph */
(function(){
  'use strict';
  var trigger=document.getElementById('dashboardLiveTrigger');
  if(!trigger)return;
  var endpoint=trigger.getAttribute('data-endpoint')||'';
  var small=document.getElementById('dashboardLiveMini');
  var large=document.getElementById('dashboardLiveLarge');
  var totalEl=document.getElementById('dashboardLiveTotal');
  var headerTotalEl=document.getElementById('dashboardLiveHeaderTotal');
  var broadbandEl=document.getElementById('dashboardLiveBroadband');
  var hotspotEl=document.getElementById('dashboardLiveHotspot');
  var updatedEl=document.getElementById('dashboardLiveUpdated');
  var cache=null,busy=false,retryTimer=null,geometry=null;
  var LINE='#2563eb';

  function n(value,fallback){var x=Number(value);return Number.isFinite(x)?x:(fallback||0);}
  function currentFromDom(){return {total:n(totalEl&&totalEl.textContent.replace(/,/g,''),n(headerTotalEl&&headerTotalEl.textContent.replace(/,/g,''),0)),broadband:n(broadbandEl&&broadbandEl.textContent.replace(/,/g,''),0),hotspot:n(hotspotEl&&hotspotEl.textContent.replace(/,/g,''),0)};}
  function theme(name,fallback){var v=getComputedStyle(document.documentElement).getPropertyValue(name).trim();return v||fallback;}
  function fit(canvas,height){if(!canvas)return null;var dpr=Math.max(1,window.devicePixelRatio||1),w=Math.max(1,canvas.clientWidth||(canvas.parentElement?canvas.parentElement.clientWidth:1)),h=height||canvas.clientHeight||30;canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);var ctx=canvas.getContext('2d');ctx.setTransform(dpr,0,0,dpr,0,0);return {ctx:ctx,w:w,h:h};}
  function fmt(value){value=n(value,0);if(Math.abs(value)>=1000){var v=value/1000;return v.toFixed(v>=10||Math.abs(v-Math.round(v))<.05?0:1)+'k';}return String(Math.round(value));}
  function normalize(series,current){var rows=Array.isArray(series)?series.slice():[],now=new Date();current=current||currentFromDom();if(!rows.length){now.setSeconds(0,0);for(var i=14;i>=0;i--){var d=new Date(now.getTime()-i*60000);rows.push({label:String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0'),total:n(current.total),broadband:n(current.broadband),hotspot:n(current.hotspot),stored:false});}return rows;}var last=null;rows.forEach(function(row){['total','broadband','hotspot'].forEach(function(k){row[k]=Number.isFinite(Number(row[k]))?Number(row[k]):null;});if(row.total!==null){last={total:row.total,broadband:n(row.broadband,current.broadband),hotspot:n(row.hotspot,current.hotspot)};}else if(last){row.total=last.total;row.broadband=row.broadband===null?last.broadband:row.broadband;row.hotspot=row.hotspot===null?last.hotspot:row.hotspot;}else{row.total=n(current.total);row.broadband=n(current.broadband);row.hotspot=n(current.hotspot);}});var end=rows[rows.length-1];end.total=n(current.total);end.broadband=n(current.broadband);end.hotspot=n(current.hotspot);return rows;}
  function scale(values){var clean=values.filter(Number.isFinite);if(!clean.length)return {min:0,max:1};var min=Math.min.apply(null,clean),max=Math.max.apply(null,clean),ref=Math.max(1,Math.abs(max)),span=Math.max(12,ref*.035,max-min);if(max===min){min=Math.max(0,min-span/2);max=min+span;}else{var pad=Math.max(span-(max-min),0)/2+(max-min)*.12;min=Math.max(0,min-pad);max=max+pad;if(max-min<1)max=min+1;}return {min:min,max:max};}
  function yFor(value,sc,top,plotH){return top+(sc.max-value)/Math.max(.0001,sc.max-sc.min)*plotH;}
  function drawLine(ctx,series,geom,dots){var points=[];series.forEach(function(row,i){var value=n(row.total,0),x=geom.left+i*geom.step,y=yFor(value,geom.scale,geom.top,geom.plotH);y=Math.max(geom.top+1,Math.min(geom.top+geom.plotH-1,y));points.push({x:x,y:y,value:value,index:i});});if(!points.length)return points;ctx.beginPath();points.forEach(function(p,i){i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y);});ctx.strokeStyle=LINE;ctx.lineWidth=dots?2.6:1.8;ctx.lineCap='round';ctx.lineJoin='round';ctx.stroke();if(dots){points.forEach(function(p){ctx.beginPath();ctx.arc(p.x,p.y,2.4,0,Math.PI*2);ctx.fillStyle=LINE;ctx.fill();ctx.lineWidth=1.2;ctx.strokeStyle=theme('--bs-body-bg','#fff');ctx.stroke();});}return points;}
  function drawMini(series){var s=fit(small,30);if(!s)return;s.ctx.clearRect(0,0,s.w,s.h);var vals=series.map(function(r){return n(r.total,0)}),sc=scale(vals),geom={left:2,top:3,plotH:s.h-6,step:(s.w-4)/Math.max(1,series.length-1),scale:sc};drawLine(s.ctx,series,geom,false);}
  function drawLarge(series){var s=fit(large,220);if(!s)return;var ctx=s.ctx,w=s.w,h=s.h,left=42,right=12,top=12,bottom=30,plotW=Math.max(40,w-left-right),plotH=h-top-bottom,step=plotW/Math.max(1,series.length-1),vals=series.map(function(r){return n(r.total,0)}),sc=scale(vals),grid=theme('--bs-border-color','#d8dee7'),muted=theme('--bs-secondary-color','#64748b');ctx.clearRect(0,0,w,h);ctx.font='10.5px system-ui';ctx.textBaseline='middle';for(var i=0;i<=3;i++){var y=top+plotH*i/3,value=sc.max-(sc.max-sc.min)*i/3;ctx.beginPath();ctx.moveTo(left,y);ctx.lineTo(w-right,y);ctx.strokeStyle=grid;ctx.lineWidth=1;ctx.stroke();ctx.fillStyle=muted;ctx.textAlign='right';ctx.fillText(fmt(value),left-7,y);}var labels=series.map(function(r){return String(r.label||'')});if(labels.length){[0,Math.floor((labels.length-1)/2),labels.length-1].forEach(function(idx,pos){var text=labels[idx]||'',x=left+idx*step;ctx.fillStyle=muted;ctx.textAlign=pos===0?'left':(pos===2?'right':'center');ctx.fillText(text,x,h-10);});}var geom={left:left,top:top,plotH:plotH,step:step,scale:sc};var points=drawLine(ctx,series,geom,true);geometry={left:left,right:w-right,top:top,bottom:top+plotH,step:step,series:series,points:points};}
  function tooltip(){if(!large||!large.parentElement)return null;var tip=large.parentElement.querySelector('.dashboard-live-tooltip');if(!tip){tip=document.createElement('div');tip.className='dashboard-live-tooltip';tip.hidden=true;large.parentElement.appendChild(tip);}return tip;}
  function hideTip(){var t=tooltip();if(t)t.hidden=true;}
  function showTip(event){if(!geometry||!geometry.series.length)return;var rect=large.getBoundingClientRect(),x=event.clientX-rect.left,y=event.clientY-rect.top;if(x<geometry.left||x>geometry.right||y<geometry.top||y>geometry.bottom){hideTip();return;}var idx=Math.max(0,Math.min(geometry.series.length-1,Math.round((x-geometry.left)/Math.max(1,geometry.step)))),row=geometry.series[idx]||{},tip=tooltip();if(!tip)return;tip.innerHTML='<strong>'+String(row.label||'')+'</strong><span>Online <b>'+n(row.total).toLocaleString()+'</b></span><span>Broadband '+n(row.broadband).toLocaleString()+' · Hotspot '+n(row.hotspot).toLocaleString()+'</span>';tip.hidden=false;var shell=large.parentElement,sr=shell.getBoundingClientRect(),tw=tip.offsetWidth||145;tip.style.left=Math.min(Math.max(8,event.clientX-sr.left-tw/2),Math.max(8,shell.clientWidth-tw-8))+'px';tip.style.top=Math.max(8,event.clientY-sr.top-tip.offsetHeight-12)+'px';}
  function status(text,stale){if(!updatedEl)return;updatedEl.textContent=text;updatedEl.classList.toggle('is-stale',!!stale);}
  function paint(data){var c=data.current||{};data.series=normalize(data.series,c);cache=data;if(totalEl)totalEl.textContent=n(c.total).toLocaleString();if(headerTotalEl)headerTotalEl.textContent=n(c.total).toLocaleString();if(broadbandEl)broadbandEl.textContent=n(c.broadband).toLocaleString();if(hotspotEl)hotspotEl.textContent=n(c.hotspot).toLocaleString();status(c.captured_at?'Updated '+String(c.captured_at).slice(11,16):'Live activity',false);drawMini(data.series);if(large)drawLarge(data.series);}
  function fallbackPaint(){if(cache)return;var c=currentFromDom(),series=normalize([],c);cache={ok:false,current:c,series:series};drawMini(series);if(large)drawLarge(series);}
  function scheduleRetry(){if(retryTimer)return;retryTimer=setTimeout(function(){retryTimer=null;if(!document.hidden)load();},12000);}
  async function fetchJson(){var controller=typeof AbortController!=='undefined'?new AbortController():null,timer=controller?setTimeout(function(){controller.abort();},9000):null;try{var r=await fetch(endpoint,{credentials:'same-origin',headers:{'X-Requested-With':'XMLHttpRequest','Accept':'application/json'},cache:'no-store',signal:controller?controller.signal:undefined});var text=await r.text(),type=(r.headers.get('content-type')||'').toLowerCase(),data=null;if(type.indexOf('application/json')!==-1||text.trim().charAt(0)==='{'){try{data=JSON.parse(text);}catch(_){data=null;}}if(!data||typeof data!=='object'){var err=new Error('Live data temporarily unavailable.');err.code='non_json';throw err;}if(!r.ok||data.ok!==true){var msg=data.message||data.error||'Live data temporarily unavailable.';var e=new Error(msg);e.code=data.error||String(r.status);throw e;}return data;}finally{if(timer)clearTimeout(timer);}}
  async function load(){if(busy||!endpoint)return;busy=true;try{paint(await fetchJson());}catch(e){fallbackPaint();var msg=(e&&e.code==='session_expired')?'Session expired — reload dashboard':'Live data temporarily unavailable — retrying';status(msg,true);scheduleRetry();}finally{busy=false;}}
  trigger.addEventListener('click',function(){if(cache)setTimeout(function(){drawLarge(cache.series||[]);},60);load();});
  if(large){large.addEventListener('mousemove',showTip);large.addEventListener('mouseleave',hideTip);}
  window.addEventListener('resize',function(){if(cache){drawMini(cache.series||[]);drawLarge(cache.series||[]);}});
  document.addEventListener('shown.bs.offcanvas',function(e){if(e.target&&e.target.id==='dashboardLiveOffcanvas'&&cache){requestAnimationFrame(function(){drawLarge(cache.series||[]);});}});
  document.addEventListener('visibilitychange',function(){if(!document.hidden)load();});
  fallbackPaint();load();setInterval(function(){if(!document.hidden)load();},60000);
})();
